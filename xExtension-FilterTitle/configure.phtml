<?php
    declare(strict_types=1);
    /** @var FilterTitleExtension $this */
    $escape = static fn(string $value): string => htmlspecialchars($value, ENT_QUOTES, 'UTF-8');
    $renderRule = function (int|string $index, array $rule) use ($escape): void { ?>
        <div class="filter-title-rule">
            <?php foreach (['field' => $this->getRuleFieldsData(), 'operator' => $this->getRuleOperatorsData()] as $control => $options) { ?>
                <div class="form-group">
                    <label class="group-name" data-rule-label="<?php echo $control; ?>" for="rule-<?php echo $index; ?>-<?php echo $control; ?>"><?php echo $escape($this->getRuleTextData('rule_' . $control)); ?></label>
                    <div class="group-controls">
                        <select data-rule-control="<?php echo $control; ?>" id="rule-<?php echo $index; ?>-<?php echo $control; ?>" name="rules[<?php echo $index; ?>][<?php echo $control; ?>]">
                            <?php if (!array_key_exists($rule[$control], $options)) { ?>
                                <option value="<?php echo $escape($rule[$control]); ?>" selected><?php echo $escape($rule[$control]); ?></option>
                            <?php } ?>
                            <?php foreach ($options as $value => $label) { ?>
                                <option value="<?php echo $value; ?>" <?php echo $rule[$control] === $value ? 'selected' : ''; ?>><?php echo $escape($label); ?></option>
                            <?php } ?>
                        </select>
                    </div>
                </div>
            <?php } ?>
            <div class="form-group">
                <label class="group-name" data-rule-label="value" for="rule-<?php echo $index; ?>-value"><?php echo $escape($this->getRuleTextData('rule_value')); ?></label>
                <div class="group-controls">
                    <input type="text" data-rule-control="value" id="rule-<?php echo $index; ?>-value" name="rules[<?php echo $index; ?>][value]" value="<?php echo $escape($rule['value']); ?>" spellcheck="false" aria-describedby="filter-title-rules-help" />
                </div>
            </div>
            <div class="form-group">
                <label class="group-name" data-rule-label="case_sensitive" for="rule-<?php echo $index; ?>-case_sensitive"><?php echo $escape($this->getRuleTextData('case_sensitive')); ?></label>
                <div class="group-controls">
                    <input type="checkbox" data-rule-control="case_sensitive" id="rule-<?php echo $index; ?>-case_sensitive" name="rules[<?php echo $index; ?>][case_sensitive]" value="1" <?php echo $rule['case_sensitive'] ? 'checked' : ''; ?> <?php echo $rule['operator'] === 'regex' ? 'disabled' : ''; ?> aria-describedby="filter-title-rules-help" />
                    <button type="submit" class="btn" name="rules_action" value="remove_<?php echo $index; ?>" data-remove-rule><?php echo $escape($this->getRuleTextData('remove_rule')); ?></button>
                </div>
            </div>
        </div>
    <?php };
?>
<form action="<?php echo _url('extension', 'configure', 'e', urlencode($this->getName())); ?>" method="post">
    <input type="hidden" name="_csrf" value="<?php echo FreshRSS_Auth::csrfToken(); ?>" />
    <!-- Keep implicit Enter submission on Save, not the first row's Remove button. -->
    <button type="submit" hidden><?php echo _t('gen.action.submit'); ?></button>

    <?php foreach ($this->getConfigurationErrors() as $error) { ?>
        <p class="alert alert-error" role="alert"><?php echo htmlspecialchars($error, ENT_QUOTES, 'UTF-8'); ?></p>
    <?php } ?>

    <div class="form-group">
        <div class="group-controls">
            <?php echo _t('ext.filter_title.keywords_desc'); ?>
        </div>
    </div>

    <div class="form-group">
        <label class="group-name" for="blacklist"><?php echo _t('ext.filter_title.blacklist'); ?></label>
        <div class="group-controls">
            <textarea name="blacklist" id="blacklist" rows="8" cols="60" spellcheck="false"><?php echo htmlspecialchars($this->getBlacklistData(), ENT_QUOTES, 'UTF-8'); ?></textarea>
            <br /><span><?php echo _t('ext.filter_title.priority_hint'); ?></span>
        </div>
    </div>

    <div class="form-group">
        <label class="group-name" for="whitelist"><?php echo _t('ext.filter_title.whitelist'); ?></label>
        <div class="group-controls">
            <textarea name="whitelist" id="whitelist" rows="8" cols="60" spellcheck="false"><?php echo htmlspecialchars($this->getWhitelistData(), ENT_QUOTES, 'UTF-8'); ?></textarea>
        </div>
    </div>

    <div class="form-group">
        <div class="group-name"><?php echo htmlspecialchars($this->getRuleTextData('additional_rules'), ENT_QUOTES, 'UTF-8'); ?></div>
        <div class="group-controls">
            <input type="hidden" name="rules_present" value="1" />
            <p id="filter-title-rules-help"><?php echo $escape($this->getRuleTextData('rules_help')); ?></p>
            <div id="filter-title-rules">
                <?php foreach ($this->getRulesData() as $index => $rule) {
                    $renderRule($index, $rule);
                } ?>
            </div>
            <template id="filter-title-rule-template">
                <?php $renderRule('__index__', ['field' => 'title', 'operator' => 'contains', 'value' => '', 'case_sensitive' => false]); ?>
            </template>
            <button type="submit" class="btn" name="rules_action" value="add" id="filter-title-add-rule"><?php echo $escape($this->getRuleTextData('add_rule')); ?></button>
        </div>
    </div>

	<div class="form-group">
		<label class="group-name" for="mark_as_read"><?= _t('ext.filter_title.mark_as_read') ?></label>
		<div class="group-controls">
			<input type="checkbox" name="mark_as_read" id="mark_as_read" value="1" <?= $this->getMarkAsReadData() ? 'checked' : '' ?>>
            <br /><span><?= _t('ext.filter_title.mark_as_read_hint') ?></span>
		</div>
	</div>

    <div class="form-group form-actions">
        <div class="group-controls">
            <button type="submit" class="btn btn-important"><?php echo _t('gen.action.submit'); ?></button>
            <button type="reset" class="btn"><?php echo _t('gen.action.cancel'); ?></button>
        </div>
    </div>
</form>
